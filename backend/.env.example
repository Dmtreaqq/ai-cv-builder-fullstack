DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_cv_builder
PORT=3000
# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

REDIS_URL=redis://localhost:6379

# Leave empty to run without AI: generation then fails with "AI generation is not configured."
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Set to true behind a reverse proxy so rate limits see the client IP
TRUST_PROXY=false
